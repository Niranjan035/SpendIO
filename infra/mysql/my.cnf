# ---------------------------------------------------------------------------
# SpendIO MySQL 8.4 production tuning (ARCHITECTURE.md Phase 15/16).
# Mounted read-only into the mysql service by docker-compose.prod.yml.
#
# The binary log is enabled so the nightly logical backup (infra/scripts/
# backup.sh) can be replayed to a point in time. Keep the same settings on a
# managed instance (RDS/Cloud SQL) via their parameter group equivalents.
# ---------------------------------------------------------------------------
[mysqld]
server-id                        = 1
log-bin                          = /var/lib/mysql/mysql-bin
binlog_format                    = ROW
binlog_expire_logs_seconds       = 604800
sync_binlog                      = 1
innodb_flush_log_at_trx_commit   = 1

character-set-server             = utf8mb4
collation-server                 = utf8mb4_0900_ai_ci
default-time-zone                = '+00:00'

max_connections                  = 200
innodb_buffer_pool_size          = 512M
innodb_flush_method              = O_DIRECT

# SQL mode mirrors the application's expectations (strict, UTC, no zero dates).
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

slow_query_log                   = 1
slow_query_log_file              = /var/lib/mysql/slow.log
long_query_time                  = 1
min_examined_row_limit           = 1000
