# ---------------------------------------------------------------------------
# SpendIO shared local environment template.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# ---------------------------------------------------------------------------

# --- MySQL (local dev stack, docker-compose.yml) ---------------------------
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=spendio
MYSQL_USER=spendio
MYSQL_PASSWORD=spendio
MYSQL_PORT=3306

# --- Backend ---------------------------------------------------------------
SPENDIO_DB_URL=jdbc:mysql://localhost:3306/spendio?createDatabaseIfNotExist=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
SPENDIO_DB_USERNAME=spendio
SPENDIO_DB_PASSWORD=spendio
SPENDIO_DB_POOL_SIZE=10
SERVER_PORT=8080

# HS256 signing secret for access tokens. MUST be >= 32 bytes.
# Generate: openssl rand -base64 48
SPENDIO_JWT_SECRET=change-me-to-a-random-48-byte-base64-string-at-least-32-bytes
SPENDIO_JWT_TTL=15m
SPENDIO_REFRESH_TTL=30d

# CORS allowlist for the SPA (comma separated, never `*` with credentials)
SPENDIO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Mail (Mailpit in dev) --------------------------------------------------
SPENDIO_MAIL_HOST=localhost
SPENDIO_MAIL_PORT=1025
SPENDIO_MAIL_USERNAME=
SPENDIO_MAIL_PASSWORD=
SPENDIO_MAIL_FROM=no-reply@spendio.local

# --- FX provider ------------------------------------------------------------
SPENDIO_FX_PROVIDER_URL=https://api.frankfurter.dev/v1
SPENDIO_FX_PROVIDER_API_KEY=

# --- Test database (used when Docker is unavailable) ------------------------
# SPENDIO_TEST_DB_URL=jdbc:mysql://localhost:3307/spendio_test?createDatabaseIfNotExist=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
# SPENDIO_TEST_DB_USERNAME=root
# SPENDIO_TEST_DB_PASSWORD=

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
