# ---------------------------------------------------------------------------
# SpendIO shared environment TEMPLATE (tracked). Copy and fill in real values:
#
#   cp .env.example .env
#
# NEVER put a real secret in this file. `.env` is gitignored; this template is
# committed. Every key appears exactly once. Placeholders are safe to keep.
# ---------------------------------------------------------------------------

# --- MySQL (docker-compose.yml + docker-compose.prod.yml) -------------------
# MYSQL_ROOT_PASSWORD and MYSQL_PASSWORD are REQUIRED by the prod overlay.
# Use strong, unique values in `.env`.
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=spendio
MYSQL_USER=spendio
MYSQL_PASSWORD=change_me_mysql_app_password
MYSQL_PORT=3306

# --- Backend ----------------------------------------------------------------
SPENDIO_DB_URL=jdbc:mysql://localhost:3306/spendio?createDatabaseIfNotExist=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
SPENDIO_DB_USERNAME=spendio
SPENDIO_DB_PASSWORD=change_me_mysql_app_password
# Single intended pool size. 10 is a reasonable local value.
SPENDIO_DB_POOL_SIZE=10
SPENDIO_DB_MIN_IDLE=5
SERVER_PORT=8080

# --- Auth -------------------------------------------------------------------
# HS256 signing secret for access tokens. MUST be >= 32 bytes.
# Generate: openssl rand -base64 48
SPENDIO_JWT_SECRET=change_me_generate_with_openssl_rand_base64_48
SPENDIO_JWT_KID=v1
SPENDIO_JWT_TTL=15m
SPENDIO_REFRESH_TTL=30d

# --- CORS / public SPA origin ----------------------------------------------
# Comma separated; never `*` with credentials. Local entry point:
SPENDIO_CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Public SPA URL used in email links.
SPENDIO_WEB_BASE_URL=http://127.0.0.1:8080

# --- Mail -------------------------------------------------------------------
# Point at a reachable SMTP relay, or a local sink for validation.
# The prod overlay never activates Mailpit (it is dev-profile only).
# For local validation without a relay, attach a Mailpit sink to the compose
# network under the alias `mailpit` (loopback-only UI). Leave username/password
# empty for an unauthenticated relay.
SPENDIO_MAIL_HOST=mailpit
SPENDIO_MAIL_PORT=1025
SPENDIO_MAIL_USERNAME=
SPENDIO_MAIL_PASSWORD=
SPENDIO_MAIL_FROM=no-reply@spendio.local

# --- FX provider ------------------------------------------------------------
SPENDIO_FX_PROVIDER_URL=https://api.frankfurter.dev/v1
SPENDIO_FX_PROVIDER_API_KEY=

# --- Frontend ---------------------------------------------------------------
VITE_API_BASE_URL=/api/v1

# --- Rate limiting / background jobs ----------------------------------------
SPENDIO_RATE_LIMIT_WINDOW=5m
SPENDIO_RATE_LIMIT_SENSITIVE=10
SPENDIO_RATE_LIMIT_AUTH=60
SPENDIO_PURGE_GRACE_DAYS=30
JAVA_OPTS=-XX:+ExitOnOutOfMemoryError

# --- Test database (used when Docker is unavailable) ------------------------
# SPENDIO_TEST_DB_URL=jdbc:mysql://localhost:3307/spendio_test?createDatabaseIfNotExist=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&useSSL=false&allowPublicKeyRetrieval=true
# SPENDIO_TEST_DB_USERNAME=root
# SPENDIO_TEST_DB_PASSWORD=

# --- Monitoring overlay (docker-compose.monitoring.yml, optional) -----------
# Bound to loopback by default; override only via an internal reverse proxy.
GRAFANA_PASSWORD=change_me_grafana_admin_password
PROMETHEUS_BIND_ADDRESS=127.0.0.1
GRAFANA_BIND_ADDRESS=127.0.0.1
BACKEND_UPSTREAM=http://backend:8080
# Bearer token Prometheus presents to scrape /actuator/prometheus.
# Generate: openssl rand -hex 32
SPENDIO_METRICS_SCRAPE_TOKEN=change_me_generate_with_openssl_rand_hex_32

# --- Production frontend entry point (docker-compose.prod.yml) --------------
# The only published host port; loopback so only the host TLS terminator reaches it.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HTTP_PORT=8080

# --- Backups (infra/scripts/backup.sh) --------------------------------------
BACKUP_DIR=./backups
