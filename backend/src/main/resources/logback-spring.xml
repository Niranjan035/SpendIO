<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_CORRELATION_PATTERN" value="%X{requestId} "/>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>${CONSOLE_LOG_CHARSET:-UTF-8}</charset>
        </encoder>
    </appender>

    <springProfile name="prod | docker">
        <include resource="logback-spring-prod.xml"/>
    </springProfile>

    <springProfile name="!prod &amp; !docker">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
